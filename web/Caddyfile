# Plain HTTP inside the server: TLS is terminated by the public tunnel in front.
{
	admin off
}

:80 {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@api path /v1/* /health /graphql /graphiql* /docs /docs/*
	handle @api {
		reverse_proxy api:8787 {
			# SSE: live tracking must not be buffered until the connection closes.
			flush_interval -1
			transport http {
				read_timeout 30m
			}
		}
	}

	handle {
		root * /srv
		# Hashed assets never change; HTML and the service worker must always revalidate.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh path / *.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		# /sos -> sos.html (postbuild writes one per public route). Anything else is a
		# real 404, served with the app shell so the router can show its own page.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}
}
