# City Shield API — every variable is OPTIONAL.
# With none set, the API starts on 127.0.0.1:8787 with the in-memory store,
# a labelled stand-in geocoder and demo-speed simulation.
# Copy to api/.env (gitignored) and fill in what you have.

PORT=8787
HOST=127.0.0.1

# Postgres + PostGIS. Neon: create a project, then paste its connection string
# (keep ?sslmode=require). Absent => in-memory store (resets on restart).
#   npm run db:migrate -w api   # creates the PostGIS extension + tables
#   npm run db:seed -w api      # stations, fleet and Command Centre sample data
DATABASE_URL=

# Browser origins allowed to call the API (Vite dev, Vite preview).
CORS_ORIGINS=http://localhost:5178,http://localhost:4178

# Signs session tokens. REQUIRED in production (the API refuses to start without it).
JWT_SECRET=

# Demo mode: new accounts get the prototype's sample data, trips play at demo
# speed, and the Command Centre is open. Defaults to on outside production.
DEMO_MODE=true
SECONDS_PER_MINUTE=12

# Development sign-in: phone OTP codes are NOT sent by SMS (no SMS provider
# agreement yet). Outside production the code is logged and returned to the
# app, which shows it on screen.

# Reverse geocoding (Mappls primary, Ola fallback, labelled mock otherwise).
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
OLA_MAPS_API_KEY=

# Behind a reverse proxy: its CIDR(s) or hop count, so rate limits key on the real client IP.
TRUST_PROXY=

# DPDP retention for live-location pings.
RETENTION_PING_DAYS=30
